{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "dom"],
		"module": "CommonJS",
		"moduleResolution": "bundler",
		"types": ["cypress"],
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}

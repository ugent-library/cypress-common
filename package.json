{
  "name": "cypress-common",
  "version": "4.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./commands": "./dist/commands/index.js",
    "./commands/*": "./dist/commands/*.js",
    "./assertions": "./dist/assertions/index.js",
    "./assertions/chai": "./dist/assertions/chai/index.js",
    "./assertions/chai/*": "./dist/assertions/chai/*.js",
    "./util": "./dist/util/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": "git@github.com:ugent-library/cypress-common.git",
  "author": "Koen Verheyen <koen.verheyen@inuits.eu>",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "biome check",
    "check-dist": "scripts/check-dist.sh",
    "format": "biome check --write",
    "lint": "tsc --noEmit && tsc --project cypress",
    "test": "cypress run",
    "precommit": "node node_modules/js-precommit-hook"
  },
  "pre-commit": [
    "check",
    "check-dist",
    "lint",
    "test",
    "precommit"
  ],
  "dependencies": {
    "chai": "^6.2.2",
    "loupe": "^3.2.1"
  },
  "peerDependencies": {
    "cypress": ">=13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/chai-dom": "^1.11.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.9.5",
    "cypress": "^16.2.0",
    "js-precommit-hook": "github:ugent-library/js-precommit-hook#semver:^v2.1.6",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "pre-commit@2.0.0": true,
    "cypress@16.2.0": true
  }
}

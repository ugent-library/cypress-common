{
	"name": "cypress-common",
	"version": "3.18.2",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./index.js": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./commands": {
			"types": "./dist/commands/index.d.ts",
			"default": "./dist/commands/index.js"
		},
		"./commands/*.js": {
			"types": "./dist/commands/*.d.ts",
			"default": "./dist/commands/*.js"
		},
		"./commands/*": {
			"types": "./dist/commands/*.d.ts",
			"default": "./dist/commands/*.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"default": "./dist/helpers/index.js"
		},
		"./helpers/index.js": {
			"types": "./dist/helpers/index.d.ts",
			"default": "./dist/helpers/index.js"
		},
		"./helpers/chai": {
			"types": "./dist/helpers/chai/index.d.ts",
			"default": "./dist/helpers/chai/index.js"
		},
		"./helpers/chai/*.js": {
			"types": "./dist/helpers/chai/*.d.ts",
			"default": "./dist/helpers/chai/*.js"
		},
		"./helpers/chai/*": {
			"types": "./dist/helpers/chai/*.d.ts",
			"default": "./dist/helpers/chai/*.js"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"dist/*": [
				"dist/*"
			],
			"commands": [
				"dist/commands/index.d.ts"
			],
			"helpers": [
				"dist/helpers/index.d.ts"
			],
			"helpers/chai": [
				"dist/helpers/chai/index.d.ts"
			],
			"*": [
				"dist/*"
			]
		}
	},
	"files": [
		"dist"
	],
	"repository": "git@github.com:ugent-library/cypress-common.git",
	"author": "Koen Verheyen <koen.verheyen@inuits.eu>",
	"license": "BSD-3-Clause",
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
		"check-dist": "scripts/check-dist.sh",
		"lint": "tsc --noEmit && tsc --project cypress",
		"test": "cypress run",
		"precommit": "node node_modules/js-precommit-hook"
	},
	"pre-commit": [
		"check-dist",
		"lint",
		"test",
		"precommit"
	],
	"dependencies": {
		"chai": "^6.2.2",
		"chai-dom": "^1.12.1"
	},
	"devDependencies": {
		"@types/chai-dom": "^1.11.3",
		"@types/lodash": "^4.17.25",
		"@types/node": "^25.9.5",
		"cypress": "^16.2.0",
		"js-precommit-hook": "github:ugent-library/js-precommit-hook#semver:^v2.1.6",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"pre-commit@2.0.0": true,
		"cypress@16.2.0": true
	}
}
